# Copy this file to .env and fill in your Supabase project's values.
# Settings → API in your Supabase dashboard has both of these.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Free API key from https://www.remove.bg/api (no card required, 50 free
# cutouts/month). Powers the "Cut out" button on closet photos. Leave blank
# to disable the feature.
EXPO_PUBLIC_REMOVEBG_API_KEY=
